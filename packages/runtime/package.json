{
  "name": "@workspace/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./dist/logger.js"
    },
    "./redis": {
      "types": "./src/redis.ts",
      "default": "./dist/redis.js"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts",
      "default": "./dist/lifecycle.js"
    },
    "./async": {
      "types": "./src/async.ts",
      "default": "./dist/async.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.3",
    "@workspace/eslint-config": "workspace:*",
    "eslint": "^9.39.2"
  }
}
