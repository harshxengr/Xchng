{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "INTERNAL_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "CORS_ORIGINS",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX",
    "ENGINE_RPC_TIMEOUT_MS",
    "PORT",
    "WS_PORT",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "MM_MARKETS",
    "MM_LOOP_INTERVAL_MS",
    "MM_LEVELS",
    "MM_BASE_PRICE",
    "MM_BASE_QUANTITY",
    "MM_SPREAD_BPS",
    "MM_LEVEL_SPACING_BPS",
    "MM_REPRICE_TOLERANCE_BPS",
    "MM_JITTER_BPS",
    "MM_TARGET_BASE_RATIO",
    "MM_MAX_INVENTORY_SKEW_BPS",
    "OPERATOR_EMAILS",
    "LOG_LEVEL",
    "SERVICE_NAME",
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "RAILWAY_PUBLIC_DOMAIN",
    "RAILWAY_STATIC_URL",
    "RAILWAY_SERVICE_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "@workspace/database#db:generate"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate",
        "@workspace/database#build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "^db:generate",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": [
        "generated/**"
      ],
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
