# Runtime
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=xchng-local
SKIP_ENV_VALIDATION=0

# Neon PostgreSQL
# Local default is provided by docker-compose.yml. Production should use the pooled Neon URL with sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xchng"

# Upstash Redis
# Local default is provided by docker-compose.yml. Production should use the Upstash Redis URL.
REDIS_URL="redis://localhost:6379"

# Auth
BETTER_AUTH_SECRET=your-super-secret-32-char-minimum-key
BETTER_AUTH_URL=http://localhost:3000
INTERNAL_SECRET=replace-with-a-32-character-service-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4001
CORS_ORIGINS=http://localhost:3000

# HTTP service ports
PORT=4000
WS_PORT=4001

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
ENGINE_RPC_TIMEOUT_MS=5000

# Market maker
MM_MARKETS=TATA_INR
MM_LOOP_INTERVAL_MS=8000
MM_LEVELS=3
MM_BASE_PRICE=100
MM_BASE_QUANTITY=2
MM_SPREAD_BPS=50
MM_LEVEL_SPACING_BPS=25
MM_REPRICE_TOLERANCE_BPS=15
MM_JITTER_BPS=8
MM_TARGET_BASE_RATIO=0.5
MM_MAX_INVENTORY_SKEW_BPS=40

# Comma-separated emails allowed to access operator pages
OPERATOR_EMAILS=admin@example.com

# Railway sets these automatically when public networking is enabled.
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=
# RAILWAY_SERVICE_NAME=
